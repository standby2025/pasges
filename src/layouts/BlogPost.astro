---
import { getCollection, type CollectionEntry } from 'astro:content';
import { articleUI, languageNames, localeNames } from '../lib/languages';
import { withBase } from '../lib/site';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = Pick<CollectionEntry<'blog'>['data'], 'title' | 'description'> &
	Partial<Pick<CollectionEntry<'blog'>['data'], 'pubDate' | 'updatedDate' | 'tags' | 'lang' | 'translationKey' | 'translationStatus'>>;

const { title, description, pubDate, updatedDate, tags = [], lang = 'zh', translationKey, translationStatus = 'original' } = Astro.props;
const ui = articleUI[lang];
const translations = translationKey
 ? (await getCollection('blog', ({ data }) => !data.draft && data.translationKey === translationKey))
 : [];
const direction = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={localeNames[lang]} dir={direction}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
  {translations.map((post) => <link rel="alternate" hreflang={post.data.lang} href={new URL(withBase(`/blog/${post.id}/`), Astro.site)} />)}
  {translationKey && <link rel="alternate" hreflang="x-default" href={new URL(withBase(`/blog/${translationKey}.zh/`), Astro.site)} />}
	</head>
	<body>
		<Header lang={lang} languageLinks={translations.map((post) => ({ lang: post.data.lang, href: withBase(`/blog/${post.id}/`) }))} />
		<main>
			<article>
				<header class="post-head">
					<h1>{title}</h1>
					<div class="meta">
						{pubDate && <FormattedDate date={pubDate} lang={localeNames[lang]} />}
						{updatedDate && <span>{ui.updated} <FormattedDate date={updatedDate} lang={localeNames[lang]} /></span>}
						{tags.map((t) => <span class="tag">{t}</span>)}
					</div>
				</header>
    {translations.length > 1 && <nav class="language-switch" aria-label={ui.languages}>
     {translations.sort((a, b) => ['zh', 'en', 'fr', 'es', 'ru', 'ar'].indexOf(a.data.lang) - ['zh', 'en', 'fr', 'es', 'ru', 'ar'].indexOf(b.data.lang)).map((post) => (
      <a href={withBase(`/blog/${post.id}/`)} lang={post.data.lang} hreflang={post.data.lang} data-language={post.data.lang} aria-current={post.data.lang === lang ? 'page' : undefined}>{languageNames[post.data.lang]}</a>
     ))}
    </nav>}
    {translationStatus === 'machine' && <p class="translation-note">{ui.machine}</p>}
				<div class="prose" lang={lang} dir={direction}><slot /></div>
			</article>
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
 .language-switch { display: flex; flex-wrap: wrap; gap: .4rem .9rem; padding-block: .8rem; margin-bottom: 1rem; border-block: 1px solid var(--line); font-size: .9rem; }
 .language-switch a[aria-current='page'] { color: var(--ink); font-weight: 700; text-decoration: none; }
 .translation-note { color: var(--muted); background: var(--code-bg); padding: .75rem 1rem; border-radius: 6px; font-size: .85rem; }

	.post-head {
		margin-bottom: 2rem;
	}
	h1 {
		margin: 0 0 0.75rem;
		font-size: 2rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.tag {
		padding: 0 0.5rem;
		border: 1px solid var(--line);
		border-radius: 3px;
		font-size: 0.8rem;
	}
</style>
