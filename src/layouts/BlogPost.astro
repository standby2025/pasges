---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = Pick<CollectionEntry<'blog'>['data'], 'title' | 'description'> &
	Partial<Pick<CollectionEntry<'blog'>['data'], 'pubDate' | 'updatedDate' | 'tags'>>;

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-head">
					<h1>{title}</h1>
					<div class="meta">
						{pubDate && <FormattedDate date={pubDate} />}
						{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
						{tags.map((t) => <span class="tag">{t}</span>)}
					</div>
				</header>
				<div class="prose"><slot /></div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-head {
		margin-bottom: 2rem;
	}
	h1 {
		margin: 0 0 0.75rem;
		font-size: 2rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.tag {
		padding: 0 0.5rem;
		border: 1px solid var(--line);
		border-radius: 3px;
		font-size: 0.8rem;
	}
</style>
