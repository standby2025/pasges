---
import { getCollection, type CollectionEntry } from 'astro:content';
import { articleUI, localeNames } from '../lib/languages';
import { withBase } from '../lib/site';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = Pick<CollectionEntry<'blog'>['data'], 'title' | 'description'> &
	Partial<Pick<CollectionEntry<'blog'>['data'], 'pubDate' | 'updatedDate' | 'tags' | 'lang' | 'translationKey' | 'translationStatus'>>;

const { title, description, pubDate, updatedDate, tags = [], lang = 'zh', translationKey, translationStatus = 'original' } = Astro.props;
const ui = articleUI[lang];
const translations = translationKey
 ? (await getCollection('blog', ({ data }) => !data.draft && data.translationKey === translationKey))
 : [];
const direction = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={localeNames[lang]} dir={direction}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
  {translations.map((post) => <link rel="alternate" hreflang={post.data.lang} href={new URL(withBase(`/blog/${post.id}/`), Astro.site)} />)}
  {translationKey && <link rel="alternate" hreflang="x-default" href={new URL(withBase(`/blog/${translationKey}.zh/`), Astro.site)} />}
	</head>
	<body>
		<div class="progress" aria-hidden="true"></div>
		<Header lang={lang} languageLinks={translations.map((post) => ({ lang: post.data.lang, href: withBase(`/blog/${post.id}/`) }))} />
		<main>
			<article>
				<header class="post-head">
					<h1>{title}</h1>
					<div class="meta">
						{pubDate && <FormattedDate date={pubDate} lang={localeNames[lang]} />}
						{updatedDate && <span>{ui.updated} <FormattedDate date={updatedDate} lang={localeNames[lang]} /></span>}
						{tags.map((t) => <span class="tag">{t}</span>)}
					</div>
				</header>
    {translationStatus === 'machine' && <p class="translation-note">{ui.machine}</p>}
				<div class="prose" lang={lang} dir={direction}><slot /></div>
			</article>
		</main>
		<Footer lang={lang} />
		<script>
			const bar = document.querySelector<HTMLElement>('.progress');
			const update = () => {
				const max = document.documentElement.scrollHeight - innerHeight;
				bar?.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
			};
			addEventListener('scroll', update, { passive: true });
			addEventListener('resize', update);
			update();
		</script>
	</body>
</html>

<style>
 .translation-note { margin: 0 0 2rem; padding: .75rem 1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--code-bg); color: var(--muted); font-size: .85rem; }
	.progress { position: fixed; inset: 0 0 auto 0; z-index: 40; height: 3px; background: var(--accent); transform: scaleX(var(--p, 0)); transform-origin: left; pointer-events: none; }
	:global([dir='rtl']) .progress { transform-origin: right; }
	.post-head {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line);
	}
	h1 {
		margin: 0 0 1rem;
		font-size: clamp(1.9rem, 5vw, 2.6rem);
		line-height: 1.3;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.9rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
