---
import { localePath } from '../lib/site';
import { articleUI, themeUI, siteUI, languages, languageNames, type Language } from '../lib/languages';
interface Props { lang?: Language; languageLinks?: { lang: Language; href: string }[]; }
const { lang = 'zh', languageLinks = languages.map((language) => ({ lang: language, href: localePath(language) })) } = Astro.props;
const site = siteUI[lang];
const ui = articleUI[lang];
const themes = themeUI[lang];

const path = Astro.url.pathname;
const links = [
	{ href: localePath(lang, '/'), label: ui.home },
	{ href: localePath(lang, '/blog/'), label: ui.posts },
	{ href: localePath(lang, '/about/'), label: ui.about },
];
const isActive = (href: string) =>
	href === localePath(lang, '/') ? path === href : path.startsWith(href) || (href === localePath(lang, '/blog/') && /\/blog\/[^/]+\/?$/.test(path));
---

<header class="site-header">
 <a class="brand" href={localePath(lang, '/')}>{site.title}</a>
 <nav class="main-nav" aria-label={site.navigation}>
  {links.map((link) => <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>)}
 </nav>
 <div class="preferences">
  <details class="picker" id="language-picker">
   <summary aria-label={site.language} title={site.language}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg>
    <span>{languageNames[lang]}</span>
    <svg class="chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
   </summary>
   <div class="picker-panel language-panel">
    <p class="panel-title">{site.language}</p>
    {languageLinks.map((link) => <a class="picker-option" href={link.href} lang={link.lang} hreflang={link.lang} data-language={link.lang} aria-current={link.lang === lang ? 'page' : undefined}>
     <span class="language-code">{link.lang.toUpperCase()}</span>
     <span class="option-label">{languageNames[link.lang]}</span>
     <span class="check" aria-hidden="true">{link.lang === lang ? '✓' : ''}</span>
    </a>)}
   </div>
  </details>
  <details class="picker" id="theme-picker">
   <summary aria-label={themes.label} title={themes.label}>
    <span class="current-swatch" aria-hidden="true"></span>
    <span>{themes.label}</span>
    <svg class="chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
   </summary>
   <div class="picker-panel theme-panel">
    <p class="panel-title">{themes.label}</p>
    {(['random', 'paper', 'mist', 'forest', 'rose', 'night'] as const).map((theme) => <button type="button" class="picker-option" data-theme-choice={theme} aria-pressed="false">
     <span class:list={['swatch', `swatch-${theme}`]} aria-hidden="true"></span>
     <span class="option-label">{themes[theme]}</span>
     <span class="check" aria-hidden="true">✓</span>
    </button>)}
   </div>
  </details>
 </div>
</header>

<script>
 const pickers = [...document.querySelectorAll<HTMLDetailsElement>('.picker')];
 const close = (except?: HTMLDetailsElement) => pickers.forEach((picker) => { if (picker !== except) picker.open = false; });
 pickers.forEach((picker) => {
  picker.querySelector('summary')?.addEventListener('click', () => { if (!picker.open) close(picker); });
 });
 document.addEventListener('click', (event) => {
  if (event.target instanceof Node && !pickers.some((picker) => picker.contains(event.target as Node))) close();
 });
 document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') {
   const current = pickers.find((picker) => picker.open);
   close(); current?.querySelector('summary')?.focus();
  }
 });
 document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
  link.addEventListener('click', () => {
   try { localStorage.setItem('blog-language', link.dataset.language || 'zh'); } catch {}
  });
 });
 const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
 const themes = ['paper', 'mist', 'forest', 'rose', 'night'];
 const syncTheme = () => {
  const selected = document.documentElement.dataset.themeMode || 'random';
  choices.forEach((choice) => choice.setAttribute('aria-pressed', String(choice.dataset.themeChoice === selected)));
 };
 choices.forEach((choice) => choice.addEventListener('click', () => {
  const value = choice.dataset.themeChoice!;
  try {
   if (value === 'random') localStorage.removeItem('blog-theme');
   else localStorage.setItem('blog-theme', value);
  } catch {}
  document.documentElement.dataset.themeMode = value;
  document.documentElement.dataset.theme = value === 'random' ? themes[Math.floor(Math.random() * themes.length)] : value;
  syncTheme(); close();
  document.querySelector<HTMLElement>('#theme-picker summary')?.focus();
 }));
 syncTheme();
</script>

<style>
 .site-header { max-width: var(--width); margin: 0 auto; padding: 1.75rem 1.25rem 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; border-bottom: 1px solid var(--line); }
 .brand { margin-inline-end: auto; font-family: var(--serif); font-size: 1.25rem; font-weight: 700; letter-spacing: .04em; overflow-wrap: anywhere; color: var(--ink); text-decoration: none; }
 .main-nav { display: flex; flex-wrap: wrap; gap: 1rem; }
 .main-nav a { color: var(--muted); text-decoration: none; font-size: .9rem; padding-block: .35rem; border-bottom: 2px solid transparent; }
 .main-nav a:hover, .main-nav a.active { color: var(--ink); border-bottom-color: var(--accent); }
 .preferences { display: flex; align-items: center; gap: .15rem; margin-inline-start: auto; }
 .picker { position: relative; }
 summary { display: flex; align-items: center; gap: .4rem; min-height: 38px; padding: .35rem .5rem; border: 1px solid transparent; border-radius: 8px; color: var(--muted); cursor: pointer; font-size: .8rem; line-height: 1.4; list-style: none; white-space: nowrap; transition: color .15s, background .15s; }
 summary::-webkit-details-marker { display: none; }
 summary:hover, details[open] summary { color: var(--ink); background: var(--code-bg); }
 summary svg { width: 16px; height: 16px; flex: none; }
 summary .chevron { width: 11px; height: 11px; opacity: .6; transition: transform .15s; }
 details[open] .chevron { transform: rotate(180deg); }
 summary:focus-visible, .picker-option:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
 .current-swatch { width: 15px; height: 15px; border-radius: 50%; background: linear-gradient(135deg, var(--paper) 45%, var(--accent) 45%); box-shadow: 0 0 0 1px var(--line); }
 .picker-panel { position: absolute; inset-inline-end: 0; top: calc(100% + 9px); z-index: 20; width: min(240px, calc(100vw - 40px)); padding: .5rem; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: 0 12px 36px #00000012, 0 2px 6px #00000008; }
 .panel-title { margin: .15rem .55rem .4rem; font-size: .7rem; color: var(--muted); letter-spacing: .04em; }
 .picker-option { display: flex; align-items: center; gap: .65rem; width: 100%; min-height: 40px; padding: .5rem .6rem; border: 0; border-radius: 7px; color: var(--ink); background: transparent; text-decoration: none; text-align: start; font-family: var(--sans); font-size: .85rem; line-height: 1.4; cursor: pointer; }
 .picker-option:hover { background: var(--code-bg); }
 .picker-option[aria-current='page'], .picker-option[aria-pressed='true'] { color: var(--accent); background: var(--code-bg); }
 .option-label { flex: 1; }
 .language-code { color: var(--muted); font: .65rem var(--mono); width: 1.6rem; }
 .check { width: 1rem; font-size: .8rem; color: var(--accent); }
 button[aria-pressed='false'] .check { visibility: hidden; }
 .swatch { width: 19px; height: 19px; border-radius: 50%; flex: none; box-shadow: inset 0 0 0 1px #00000014; }
 .swatch-random { background: conic-gradient(#275fa4, #356b45, #9b3c60, #18212e, #8a3b2e, #275fa4); }
 .swatch-paper { background: linear-gradient(135deg,#faf8f4 50%,#8a3b2e 50%); }
 .swatch-mist { background: linear-gradient(135deg,#f4f7fb 50%,#275fa4 50%); }
 .swatch-forest { background: linear-gradient(135deg,#f3f7f1 50%,#356b45 50%); }
 .swatch-rose { background: linear-gradient(135deg,#fcf5f6 50%,#9b3c60 50%); }
 .swatch-night { background: linear-gradient(135deg,#18212e 50%,#91bbf2 50%); }
 @media (max-width: 560px) {
  .site-header { gap: .7rem .5rem; }
  .brand { flex-basis: 100%; }
  .main-nav { gap: .8rem; }
  .main-nav a { font-size: .85rem; }
  summary { padding-inline: .4rem; }
  summary .chevron { display: none; }
 }
 @media (prefers-reduced-motion: reduce) { summary, summary .chevron { transition: none; } }
</style>
