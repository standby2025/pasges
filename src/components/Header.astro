---
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/site';

const path = Astro.url.pathname;
const links = [
	{ href: withBase('/'), label: '首页' },
	{ href: withBase('/blog/'), label: '文章' },
	{ href: withBase('/about/'), label: '关于' },
];
const isActive = (href: string) =>
	href === withBase('/') ? path === href : path.startsWith(href);
---

<header class="site-header">
	<a class="brand" href={withBase('/')}>{SITE_TITLE}</a>
	<nav>
		{links.map((l) => <a href={l.href} class:list={{ active: isActive(l.href) }}>{l.label}</a>)}
	</nav>
 <label class="theme-picker">
  <span>配色</span>
  <select id="theme-select" aria-label="选择页面配色">
   <option value="random">每次随机</option>
   <option value="paper">暖纸 · 米白</option>
   <option value="mist">晴雾 · 蓝灰</option>
   <option value="forest">松林 · 浅绿</option>
   <option value="rose">蔷薇 · 淡粉</option>
   <option value="night">深海 · 夜色</option>
  </select>
 </label>
</header>

<script>
 const select = document.querySelector<HTMLSelectElement>('#theme-select');
 const themes = ['paper', 'mist', 'forest', 'rose', 'night'];
 if (select) {
  select.value = document.documentElement.dataset.themeMode || 'random';
  select.addEventListener('change', () => {
   const value = select.value;
   try {
    if (value === 'random') localStorage.removeItem('blog-theme');
    else localStorage.setItem('blog-theme', value);
   } catch {}
   document.documentElement.dataset.themeMode = value;
   document.documentElement.dataset.theme = value === 'random'
    ? themes[Math.floor(Math.random() * themes.length)] : value;
  });
 }
</script>

<style>
 .theme-picker { display: flex; align-items: center; gap: .4rem; color: var(--muted); font-size: .8rem; }
 select { max-width: 10rem; border: 1px solid var(--line); border-radius: 6px; padding: .35rem .45rem; background: var(--code-bg); color: var(--ink); font: inherit; cursor: pointer; }
 select:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
 @media (max-width: 600px) { .site-header { flex-wrap: wrap; } .theme-picker { flex-basis: 100%; } }

	.site-header {
		max-width: var(--width);
		margin: 0 auto;
		padding: 1.75rem 1.25rem 1.25rem;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--line);
	}
	.brand {
		font-family: var(--serif);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--ink);
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1.25rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		padding-bottom: 2px;
		border-bottom: 2px solid transparent;
	}
	nav a:hover,
	nav a.active {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}
</style>
