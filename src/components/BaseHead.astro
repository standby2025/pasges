---
import '../styles/global.css';
import { siteUI, type Language } from '../lib/languages';
import { localePath, withBase } from '../lib/site';

interface Props {
	title: string;
	description: string;
 lang?: Language;
}
const { title, description, lang = 'zh' } = Astro.props;
const siteTitle = siteUI[lang].title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
<link rel="sitemap" href={withBase('sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={siteTitle} href={localePath(lang, 'rss.xml')} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />

<!-- 首次绘制前应用配色，避免页面闪色；随机模式只在本次文档加载时抽取。 -->
<script is:inline>
 (() => {
  const themes = ['paper', 'mist', 'forest', 'rose', 'night'];
  let saved = null;
  try { saved = localStorage.getItem('blog-theme'); } catch {}
  const fixed = themes.includes(saved);
  document.documentElement.dataset.theme = fixed ? saved : themes[Math.floor(Math.random() * themes.length)];
  document.documentElement.dataset.themeMode = fixed ? saved : 'random';
 })();
</script>
