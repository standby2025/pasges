---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site';
import { localeNames, type Language } from '../lib/languages';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	lang?: Language;
	featured?: boolean;
}
const { posts, lang = 'zh', featured = false } = Astro.props;
const arrow = lang === 'ar' ? '←' : '→';
---

<ul class="post-list">
	{
		posts.map((post, index) => (
			<li class:list={{ featured: featured && index === 0 }}>
				<a href={withBase(`/blog/${post.id}/`)}>
					<div class="meta">
						<FormattedDate date={post.data.pubDate} lang={localeNames[lang]} />
					</div>
					<h3>{post.data.title}</h3>
					<p>{post.data.description}</p>
					<div class="foot">
						<span class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
						<span class="arrow" aria-hidden="true">{arrow}</span>
					</div>
				</a>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li.featured {
		grid-column: 1 / -1;
	}
	a {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.4rem 1.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--card);
		color: inherit;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}
	a:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		box-shadow: var(--shadow);
	}
	.meta {
		margin-bottom: 0.5rem;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	h3 {
		margin: 0 0 0.5rem;
		font-family: var(--serif);
		font-size: 1.25rem;
		line-height: 1.45;
		color: var(--ink);
		transition: color 0.18s;
	}
	li.featured h3 {
		font-size: 1.75rem;
	}
	a:hover h3 {
		color: var(--accent);
	}
	p {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.75;
	}
	li.featured p {
		-webkit-line-clamp: 4;
		max-width: 46rem;
		font-size: 1.02rem;
	}
	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.arrow {
		color: var(--accent);
		transition: transform 0.18s;
	}
	a:hover .arrow {
		transform: translateX(4px);
	}
	:global([dir='rtl']) a:hover .arrow {
		transform: translateX(-4px);
	}
	@media (prefers-reduced-motion: reduce) {
		a, h3, .arrow { transition: none; }
		a:hover { transform: none; }
	}
</style>
